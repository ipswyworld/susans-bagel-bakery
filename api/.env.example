# Local dev uses SQLite automatically. For production paste your Postgres URL (Neon/Render/Railway).
DATABASE_URL=sqlite:///./bagels.db
# Long random string: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Dev only. In production use a hash instead: python -m app.hashpw
ADMIN_PASSWORD=bagels-dev
ADMIN_PASSWORD_HASH=
# Comma-separated list of sites allowed to call the API
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://YOUR-GITHUB-USERNAME.github.io
